      ]
    },
    {
      "name": "2.a) Datos inválidos (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroDocumento\": 42222222,\n  \"libretaUniversitaria\": 777777,\n  \"nombre\": \"Juan\",\n  \"edad\": -5,\n  \"genero\": \"Male\",\n  \"ciudadResidencia\": \"Tandil\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes"
          ]
        },
        "description": "Falta el apellido y la edad es negativa. Espera 400 Bad Request con el detalle de cada error."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Informa qué campos están mal', () => pm.expect(pm.response.json().message).to.include('apellido'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2.d) Buscar estudiante por LU existente (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes/libreta/34978",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes",
            "libreta",
            "34978"
          ]
        },
        "description": "Recupera el estudiante con libreta universitaria 34978 (Isidro Blackmuir precargado desde el CSV). Espera 200 OK."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve el estudiante correcto', () => {",
              "  const e = pm.response.json();",
              "  pm.expect(e.libretaUniversitaria).to.eql(34978);",
              "  pm.expect(e.nombre).to.eql('Isidro');",
              "  pm.expect(e.apellido).to.eql('Blackmuir');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2.d) Buscar estudiante por LU inexistente (404)",
