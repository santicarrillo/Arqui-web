          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroDocumento\": 41111111,\n  \"libretaUniversitaria\": 34978,\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Gomez\",\n  \"edad\": 22,\n  \"genero\": \"Female\",\n  \"ciudadResidencia\": \"Tandil\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes"
          ]
        },
        "description": "La LU 34978 ya está en el CSV (Isidro Blackmuir). Espera 409 Conflict."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409 Conflict', () => pm.response.to.have.status(409));",
